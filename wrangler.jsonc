{
  // Sirona — training log (Will It Build 002)
  // Deploy:  npx wrangler deploy
  // Login is username/password in D1 (session cookie). Optional reset mail:
  //   npx wrangler secret put RESEND_API_KEY
  //   npx wrangler secret put MAIL_FROM
  // The custom domain below is created automatically on deploy (DNS + cert),
  // since will-it-build.com is on the same Cloudflare account.
  "name": "sirona",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "routes": [
    { "pattern": "sirona.will-it-build.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sirona-db",
      "database_id": "235d3980-6a6d-434a-ac60-3b73e6d088ff"
    }
  ]
}
